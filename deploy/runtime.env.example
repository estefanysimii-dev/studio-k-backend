# Copy to /srv/studio-k/.env, outside the ./app Git checkout; chmod 600.
# Keep original credential values. Do not commit the completed file.
STUDIO_DOMAIN=SEU-BACKEND.invalid
PUBLIC_URL=https://SEU-BACKEND.invalid
PORTFOLIO_BACKEND_URL=https://SEU-BACKEND.invalid
PORTFOLIO_PUBLIC_URL=https://studiokatelier.infinityfreeapp.com
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_GUILD_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SETUP_KEY=
# Optional translation; keep blank to disable until configured in the admin panel.
# Cloudflare Free: set provider=cloudflare plus Account ID and official Workers AI API token.
# Custom token requires Workers AI Read AND Edit. Never paste it into the portfolio.
TRANSLATION_PROVIDER=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Alternative explicit provider=libretranslate. No default Railway private hostname remains.
LIBRETRANSLATE_URL=
LIBRETRANSLATE_API_KEY=
# Enable only after a sandbox test on the new public HTTPS endpoint.
PURINCASH_ENABLED=false
PURINCASH_API_KEY=
PURINCASH_WEBHOOK_SECRET=
